digraph layout{
rankdir=TB;
splines=ortho;
node [style=filled shape=square fixedsize=true width=0.6];
pe0 [label="in\n0 0 0 \n0",tooltip="add $0 $istream 0\nroute $0 $alu $2\n",fontsize=9,  fillcolor=greenyellow];
pe1[label="1", fontsize=8, fillcolor=white];
pe2 [label="addi\n0 0 0 \n2",tooltip="add $2 3 $0\nroute $2 $alu $3\n" ,fontsize=9, fillcolor=lightblue ];
pe3 [label="out\n3",tooltip="add $3 $2 0\nroute $3 $alu $ostream\n",fontsize=9, fillcolor=lightpink];
edge [constraint=false];
pe0 -> pe1[style="penwidth(0.1)", color=grey89];
pe0 -> pe2 [color=red];
pe1 -> pe0[style="penwidth(0.1)", color=grey89];
pe1 -> pe3[style="penwidth(0.1)", color=grey89];
pe2 -> pe0[style="penwidth(0.1)", color=grey89];
pe2 -> pe3 [color=red];
pe3 -> pe1[style="penwidth(0.1)", color=grey89];
pe3 -> pe2[style="penwidth(0.1)", color=grey89];
edge [constraint=true, style=invis];
pe0 -> pe2;
pe1 -> pe3;
rank = same {pe0 ->pe1 };
rank = same {pe2 ->pe3 };
}
