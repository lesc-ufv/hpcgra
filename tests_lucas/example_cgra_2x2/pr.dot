digraph layout{
rankdir=TB;
splines=ortho;
node [style=filled shape=square fixedsize=true width=0.5];
x0y0 [label="in0", fillcolor=snow2];
x0y1 [label="add1", fillcolor=lightskyblue];
x1y0 [label="in2", fillcolor=snow2];
x1y1 [label="out3", fillcolor=snow2];
edge [constraint=false];
x0y0 -> x0y1 [style=solid, color=red];
x0y1 -> x1y1 [style=solid, color=red];
x1y0 -> x1y1 [style=solid, color=red];
x1y1 -> x0y1 [style=solid, color=blue];
edge [constraint=true, style=invis];
x0y0 -> x1y0;
x0y1 -> x1y1;
rank = same {x0y0 ->x0y1 };
rank = same {x1y0 ->x1y1 };
}
