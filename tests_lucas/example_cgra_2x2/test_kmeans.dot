digraph layout{
rankdir=TB;
splines=ortho;
node [style=filled shape=square fixedsize=true width=0.6];
pe0 [label="in[0]\n0 0 0 1 \n0",tooltip="kmeans $0 $2 0 0 #1 $istream[0]\nroute $0 $alu[0] $1\n",fontsize=9,  fillcolor=greenyellow];
pe1 [label="router\n1",tooltip="route $1 $0 $3\n",fontsize=9, fillcolor=lightyellow];
pe2 [label="in[0]\n0 0 \n2",tooltip="add $2 $istream[0] 0\nroute $2 $alu[0] $0\n",fontsize=9,  fillcolor=greenyellow];
pe3 [label="out[0]\n3",tooltip="route $3 $1 $ostream[0]\n",fontsize=9, fillcolor=lightpink];
edge [constraint=false];
pe0 -> pe1 [color=red];
pe0 -> pe2[style="penwidth(0.1)", color=grey89];
pe1 -> pe0[style="penwidth(0.1)", color=grey89];
pe1 -> pe3 [color=blue];
pe2 -> pe0 [color=red];
pe2 -> pe3[style="penwidth(0.1)", color=grey89];
pe3 -> pe1[style="penwidth(0.1)", color=grey89];
pe3 -> pe2[style="penwidth(0.1)", color=grey89];
edge [constraint=true, style=invis];
pe0 -> pe2;
pe1 -> pe3;
rank = same {pe0 ->pe1 };
rank = same {pe2 ->pe3 };
}
